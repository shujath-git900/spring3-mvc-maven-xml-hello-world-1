pipeline {
    agent any

    stages {
        stage('Code Lint') {
        when {
          allOf {
            not {buildingTag()}
            branch 'master'
              }
            }
         steps {
           sh "env"
            }
        }

stage('Unit Test') {
        when {
          allOf {
            not {buildingTag()}
            branch 'master'
              }
            }

            steps {
                echo 'Unit Test'
            }
        }
stage('Integration Test') {
         when {
           allOf {
             not {buildingTag()}
             branch 'master'
               }
             }

            steps {
                echo 'Integration Test'
            }
        }
stage('Sonar Scan') {
         when {
           allOf {
             not {buildingTag()}
             branch 'master'
               }
             }

            steps {
                echo 'Sonar Scan'
            }
        }

        stage('Build Code') {
                when { buildingTag() }
                    steps {
                        echo 'Build Code'
                    }
                }

stage('Software Release') {
        when { buildingTag() }
            steps {
                echo 'Software Release'
            }
        }
    }
}
